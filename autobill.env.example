# Copy to autobill.env next to compose.yaml, fill in, then: chmod 600 autobill.env
# Never commit the real file (it is in .gitignore).

# The mailbox password: for iCloud an app-specific password (account.apple.com).
AUTOBILL_IMAP_PASSWORD=

# Only if sending uses a different mailbox than receiving:
# AUTOBILL_SMTP_PASSWORD=

# Optional: the AI suggestion interface (autobill uncategorised --suggest), when configured.
# AUTOBILL_AI_API_KEY=
