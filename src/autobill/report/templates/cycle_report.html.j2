{#- Statement-month progress e-mail (docs/notify.md#账单月进度邮件), for Apple Mail on iPhone.
    Apple's own design language: large title, inset grouped lists with inset hairlines,
    an Activity-ring progress, Wallet-style card thumbnails, Calendar-style date tiles,
    a Screen Time-style daily chart; Copilot Money-style emoji category tiles and one
    stacked category bar. Long lists fold away with the CSS checkbox hack (no script). -#}
{%- macro icon(state) -%}
{%- if state == "arrived" -%}
<svg class="ico" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 6.3l2.3 2.3 4.7-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- elif state == "pending" -%}
<svg class="ico" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M6 3.5V6l1.7 1.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
{%- else -%}
<svg class="ico" viewBox="0 0 12 12" aria-hidden="true"><circle cx="6" cy="6" r="4.6" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M6 3.4v3.1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="6" cy="8.6" r=".85" fill="currentColor"/></svg>
{%- endif -%}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
{# iOS Mail would otherwise turn amounts, dates and card numbers into blue links #}
<meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
<meta name="x-apple-disable-message-reformatting">
<title>{{ r.subject }}</title>
<style>
  /* iOS system colours (grouped background, labels, separators); data colours are the
     validated categorical slots 1-4 plus grey, checked with the dataviz validator. */
  :root {
    --bg: #f2f2f7; --card: #ffffff; --label: #000000;
    --label2: rgba(60,60,67,.6); --label3: rgba(60,60,67,.3); --sep: rgba(60,60,67,.29);
    --fill: rgba(120,120,128,.12); --fill2: rgba(120,120,128,.2);
    --accent: #2a78d6; --green: #248a3d; --orange: #c93400;
    --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; --s4: #eda100; --other: #8e8e93;
    --thumb: linear-gradient(135deg, #5b5b60 0%, #2c2c2e 100%);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #000000; --card: #1c1c1e; --label: #ffffff;
      --label2: rgba(235,235,245,.6); --label3: rgba(235,235,245,.3); --sep: rgba(84,84,88,.65);
      --fill: rgba(120,120,128,.24); --fill2: rgba(120,120,128,.36);
      --accent: #3987e5; --green: #30d158; --orange: #ff9f0a;
      --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --other: #8e8e93;
      --thumb: linear-gradient(135deg, #6e6e73 0%, #3a3a3c 100%);
    }
  }
  a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important;
    font-size: inherit !important; font-family: inherit !important; font-weight: inherit !important; line-height: inherit !important; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--label);
         font-family: -apple-system, "SF Pro Text", "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
         font-size: 17px; line-height: 1.3; -webkit-text-size-adjust: 100%; -webkit-font-smoothing: antialiased; }
  .preheader { display: none !important; max-height: 0; overflow: hidden; opacity: 0; font-size: 1px; line-height: 1px; }
  .wrap { max-width: 560px; margin: 0 auto; padding: 8px 16px 36px; }
  .num { font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* navigation-style header */
  .eyebrow { font-size: 13px; font-weight: 600; color: var(--label2); margin-top: 14px; }
  h1 { font-size: 34px; line-height: 41px; font-weight: 700; letter-spacing: .2px; margin: 2px 0 2px; }
  .subtitle { font-size: 15px; color: var(--label2); margin-bottom: 18px; }

  /* grouped sections */
  .sh { font-size: 13px; color: var(--label2); margin: 26px 16px 7px; }
  .sf { font-size: 13px; color: var(--label2); margin: 7px 16px 0; line-height: 1.4; }
  .card { background: var(--card); border-radius: 14px; padding: 16px; }
  .group { background: var(--card); border-radius: 14px; overflow: hidden; }
  .caption { font-size: 13px; color: var(--label2); line-height: 1.35; }

  /* money, Apple Card style: big rounded figures with small cents */
  .hero { font-family: ui-rounded, -apple-system, "SF Pro Rounded", "PingFang SC", sans-serif;
          font-size: 34px; font-weight: 700; letter-spacing: -.5px; line-height: 1.15; margin: 3px 0 4px;
          font-variant-numeric: tabular-nums; white-space: nowrap; }
  .hero .cur { font-size: .62em; font-weight: 600; margin-right: 1px; }
  .hero .dec { font-size: .55em; font-weight: 600; color: var(--label2); }
  .hero.md { font-size: 28px; }

  /* donut: one arc per share, the total in the middle */
  .donut-wrap { text-align: center; margin: 6px 0 10px; }
  svg.donut { display: inline-block; width: 180px; height: 180px; max-width: 100%; }
  svg.donut circle { fill: none; stroke-width: 30; }
  svg.donut .track { stroke: var(--fill); }
  svg.donut .s1 { stroke: var(--s1); } svg.donut .s2 { stroke: var(--s2); }
  svg.donut .s3 { stroke: var(--s3); } svg.donut .s4 { stroke: var(--s4); }
  svg.donut .other { stroke: var(--other); }
  svg.donut .none { stroke: var(--other); opacity: .45; }
  svg.donut .donut-num { fill: var(--label); font-size: 24px; font-weight: 700; font-family: ui-rounded, -apple-system, sans-serif; font-variant-numeric: tabular-nums; }
  svg.donut .donut-cap { fill: var(--label2); font-size: 12px; font-weight: 500; }
  .change { display: inline-block; font-size: 13px; color: var(--label2); background: var(--fill); border-radius: 12px; padding: 3px 10px; }

  /* list cells with inset hairlines, as in Settings and Wallet */
  .cell { display: flex; align-items: center; gap: 12px; padding-left: 16px; position: relative; }
  .cell .body { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: 10px;
                padding: 11px 16px 11px 0; min-height: 60px; }
  .cell + .cell .body, .panel .cell .body, .panel + .cell .body { border-top: .5px solid var(--sep); }
  .text { min-width: 0; }
  .title { font-size: 17px; line-height: 22px; overflow-wrap: anywhere; }
  .sub { font-size: 13px; line-height: 18px; color: var(--label2); margin-top: 1px; overflow-wrap: anywhere; }
  .trail { text-align: right; flex-shrink: 0; }
  .amt { font-size: 17px; font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .state { font-size: 12px; margin-top: 2px; white-space: nowrap; }
  .state.arrived { color: var(--green); }
  .state.pending { color: var(--label2); }
  .state.missing { color: var(--orange); }
  .ico { width: 12px; height: 12px; vertical-align: -1px; margin-right: 3px; }
  .cell.pending .title, .cell.missing .title { color: var(--label2); }
  .badge { display: inline-block; font-size: 11px; font-weight: 600; line-height: 16px; padding: 0 6px; border-radius: 8px;
           background: var(--accent); color: #ffffff; vertical-align: 2px; margin-left: 4px; }

  /* Wallet-style card thumbnail (no bank branding: bank initial and last digits only) */
  .thumb { width: 44px; height: 29px; border-radius: 5px; background: var(--thumb); flex-shrink: 0; position: relative;
           box-shadow: inset 0 0 0 .5px rgba(255,255,255,.18); color: #ffffff; }
  .thumb .t-bank { position: absolute; left: 5px; top: 3px; font-size: 10px; font-weight: 600; }
  .thumb .t-num { position: absolute; right: 5px; bottom: 3px; font-size: 8px; letter-spacing: .3px; opacity: .85; font-variant-numeric: tabular-nums; }
  .cell.pending .thumb, .cell.missing .thumb { opacity: .45; }

  /* emoji tiles, tinted with the category colour */
  .tile { width: 32px; height: 32px; border-radius: 8px; flex-shrink: 0; display: flex; align-items: center; justify-content: center;
          font-size: 17px; line-height: 1; background: var(--fill); }
  .tile.s1 { background: rgba(42,120,214,.16); } .tile.s2 { background: rgba(235,104,52,.16); }
  .tile.s3 { background: rgba(27,175,122,.16); } .tile.s4 { background: rgba(237,161,0,.18); }
  .tile.sm { width: 30px; height: 30px; border-radius: 15px; font-size: 15px; }

  .key { display: inline-block; width: 4px; height: 16px; border-radius: 2px; margin-right: 8px; vertical-align: -3px; }
  .key.s1 { background: var(--s1); } .key.s2 { background: var(--s2); } .key.s3 { background: var(--s3); }
  .key.s4 { background: var(--s4); } .key.other { background: var(--other); }
  .key.none { background: repeating-linear-gradient(135deg, var(--other) 0 2px, var(--fill2) 2px 5px); }
  .rows .row { display: flex; align-items: center; gap: 12px; }
  .rows .rbody { flex: 1; min-width: 0; display: flex; align-items: center; gap: 8px; padding: 10px 0; }
  .rows .row + .row .rbody { border-top: .5px solid var(--sep); }
  .rows .name { flex: 1; min-width: 0; font-size: 15px; }
  .rows .pct { font-size: 13px; color: var(--label2); width: 40px; text-align: right; font-variant-numeric: tabular-nums; }
  .rows .amt { font-size: 15px; min-width: 84px; text-align: right; }

  /* daily spending, all cards added up */
  svg.daily { width: 100%; height: auto; display: block; margin: 16px 0 6px; }
  svg.daily .bar { fill: var(--accent); }
  svg.daily .axis { stroke: var(--sep); stroke-width: 1.5; }
  svg.daily .avg { stroke: var(--label3); stroke-width: 2; stroke-dasharray: 6 6; }
  svg.daily text { fill: var(--label2); font-size: 20px; font-family: -apple-system, sans-serif; }
  svg.daily .value { fill: var(--label); font-weight: 600; }
  /* accordion: CSS checkbox hack, closed by default */
  .acc { display: none; }
  label.cell { cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .chev { color: var(--label3); font-size: 22px; line-height: 1; transition: transform .2s; display: inline-block; }
  .acc:checked + label .chev { transform: rotate(90deg); }
  .acc:checked + label .when-closed { display: none; }
  .when-open { display: none; }
  .acc:checked + label .when-open { display: inline; }
  .panel { display: none; }
  .acc:checked + label + .panel { display: block; }
  .day { font-size: 13px; font-weight: 600; color: var(--label2); padding: 14px 16px 6px; background: var(--bg); }
  .panel .cell .body { min-height: 52px; padding-top: 9px; padding-bottom: 9px; }
  .panel .title { font-size: 15px; line-height: 20px; }
  .panel .sub { font-size: 12px; line-height: 16px; }
  .panel .amt { font-size: 15px; }
  .amt.credit { color: var(--green); }
  .cell.excluded .title, .cell.excluded .amt { color: var(--label2); }
  .tag { font-size: 11px; color: var(--label2); background: var(--fill); border-radius: 4px; padding: 0 4px; margin-right: 4px; vertical-align: 1px; }

  footer { font-size: 12px; color: var(--label2); text-align: center; margin-top: 28px; line-height: 1.5; }
</style>
</head>
<body>
<div class="preheader">{{ r.preview }}{% for _ in range(40) %}&#8199;&#847;{% endfor %}</div>
<div class="wrap">

  <div class="eyebrow">AutoBill · 信用卡账单</div>
  <h1>{{ r.title }}</h1>
  <div class="subtitle">{% if r.complete %}✓ {% endif %}{{ r.status_line }}</div>

  <section class="card">
    <div class="caption">本月合计应还</div>
    <div class="hero">{% if r.due_total is none %}见下方各卡{% else %}{{ r.due_total | yuan }}{% endif %}</div>
    <div class="caption">{{ r.arrived }} 张卡的账单{% if r.missing %} · {{ r.missing }} 张可能无账单{% endif %}</div>
  </section>

  <div class="sh">卡片</div>
  <section class="group">
    {% for s in r.cards %}
    <div class="cell {{ s.state }}">
      <div class="thumb"><span class="t-bank">{{ s.bank[:1] }}</span><span class="t-num">•• {{ s.last4 }}</span></div>
      <div class="body">
        <div class="text">
          <div class="title">{{ s.label }}</div>
          <div class="sub">{{ s.note }}</div>
        </div>
        <div class="trail">
          {% if s.amount %}<div class="amt num">{{ s.amount }}</div>{% endif %}
          {% if s.amount_orig %}<div class="sub num">{{ s.amount_orig }}</div>{% endif %}
          <div class="state {{ s.state }}">{{ icon(s.state) }}{{ s.chip }}</div>
        </div>
      </div>
    </div>
    {% endfor %}
  </section>

  {% if r.segments %}
  <div class="sh">本月消费</div>
  <section class="card">
    <div class="donut-wrap">
      {{ r.category_donut }}
      {% if r.spend_change %}<div class="change">{{ r.spend_change }}</div>{% endif %}
    </div>
    <div class="rows">
      {% for g in r.segments %}
      <div class="row">
        <span class="tile {{ g.tone }}">{{ g.emoji }}</span>
        <div class="rbody">
          <span class="name"><i class="key {{ g.tone }}"></i>{{ g.name }}</span>
          <span class="pct">{{ g.share }}</span>
          <span class="amt num">{{ g.amount }}</span>
        </div>
      </div>
      {% endfor %}
    </div>
    <div class="caption">{{ r.arrived }} 张卡合计 · 已扣返现和退款 · 外币折人民币</div>
  </section>
  {% if r.segments[-1].tone == "none" %}<div class="sf">未分类的商户：在电脑上运行 autobill uncategorised，补进 rules.yaml，下次就能归类。</div>{% endif %}
  {% endif %}

  {% if r.daily_caption %}
  <div class="sh">每日消费</div>
  <section class="card">
    {{ r.daily_chart }}
    <div class="caption">{{ r.daily_caption }}。虚线是日均。</div>
  </section>
  {% endif %}

  {% if r.biggest %}
  <div class="sh">最大的一笔</div>
  <section class="group">
    <div class="cell">
      <span class="tile">{{ r.biggest.emoji }}</span>
      <div class="body">
        <div class="text">
          <div class="title">{{ r.biggest.title }}</div>
          <div class="sub">{{ r.biggest.when }} · {{ r.biggest.card }}</div>
        </div>
        <div class="trail">
          <div class="amt num">{{ r.biggest.local }}</div>
          {% if r.biggest.cny %}<div class="sub num">{{ r.biggest.cny }}</div>{% endif %}
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  {% if r.merchants %}
  <div class="sh">花得最多的商户</div>
  <section class="card">
    <div class="donut-wrap">{{ r.merchant_donut }}</div>
    <div class="rows">
      {% for m in r.merchants %}
      <div class="row">
        <span class="tile sm {{ m.tone }}">{{ m.emoji }}</span>
        <div class="rbody">
          <span class="name"><i class="key {{ m.tone }}"></i>{{ m.name }}</span>
          <span class="pct">{{ m.share }}</span>
          <span class="amt num">{{ m.amount }}</span>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if r.days %}
  <div class="sh">全部流水</div>
  <section class="group">
    <input type="checkbox" id="tx" class="acc">
    <label for="tx" class="cell">
      <span class="tile">🧾</span>
      <div class="body">
        <div class="text"><div class="title">全部 {{ r.transaction_count }} 笔流水</div><div class="sub"><span class="when-closed">轻点展开 · 全部卡，按日期</span><span class="when-open">轻点收起</span></div></div>
        <span class="chev">›</span>
      </div>
    </label>
    <div class="panel">
      {% for day in r.days %}
      <div class="day">{{ day.label }}</div>
      {% for t in day.lines %}
      {% set credit = "-" in t.local %}
      {% set notes = [t.card] + t.meta %}
      <div class="cell{% if t.excluded %} excluded{% endif %}" data-line="{{ t.line_no }}">
        <span class="tile sm">{{ t.category | emoji(t.tag) }}</span>
        <div class="body">
          <div class="text">
            <div class="title">{% if t.tag %}<span class="tag">{{ t.tag }}</span>{% endif %}{{ t.title }}</div>
            <div class="sub">{{ notes | join(" · ") }}{% if t.excluded %} · 不计入支出{% endif %}</div>
          </div>
          <div class="trail">
            <div class="amt num{% if credit and not t.excluded %} credit{% endif %}">{{ t.local | replace("-", "+") }}</div>
            {% if t.cny %}<div class="sub num">{{ t.cny }}</div>{% endif %}
          </div>
        </div>
      </div>
      {% endfor %}
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <footer>
    外币按账单邮件当天的汇率折合人民币<br>
    AutoBill 自动生成 · 金额以银行原账单为准<br>
    生成于 {{ r.generated_at }}
  </footer>
</div>
</body>
</html>
